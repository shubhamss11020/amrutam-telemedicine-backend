# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://amrutam_user:amrutam_secure_pass@localhost:5432/amrutam_telemedicine?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=amrutam_user
DB_PASSWORD=amrutam_secure_pass
DB_NAME=amrutam_telemedicine
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MILLIS=30000

# Redis Configuration (Cache, Distributed Locks, Rate Limiting)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=false

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_key_min_32_characters_long_amrutam_2026
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_characters_long_amrutam_2026
JWT_REFRESH_EXPIRES_IN=7d

# Healthcare Data Encryption (AES-256-GCM: Must be exactly 32-byte / 64 hex characters)
# Generated via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Concurrency & Idempotency Rules
IDEMPOTENCY_TTL_SECONDS=86400
SLOT_RESERVATION_TIMEOUT_MINUTES=10

# Logging & Observability
LOG_LEVEL=info
PROMETHEUS_METRICS_ENABLED=true
